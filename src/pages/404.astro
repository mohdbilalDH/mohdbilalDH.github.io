---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lede">This page doesn't exist — or, like much of the archive, it once did and left no record.</p>
    </div>
    <p style="margin-bottom: var(--s-7);">
      Try the <a href="/">home page</a>, <a href="/projects/">projects</a>, or
      <a href="/publications/">publications</a>.
    </p>
  </div>
</Base>
