---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
---
<Base title="Page not found">
  <div class="wrap">
    <div class="page-head">
      <Eyebrow>404</Eyebrow>
      <h1>Page not found</h1>
      <p class="lede prose">This page doesn't exist — or, like much of the archive, it once did and left no record.</p>
    </div>
    <p class="prose">
      Try the <a href="/">home page</a>, the <a href="/projects/">projects</a>, the
      <a href="/method/">method</a> behind them, or the <a href="/writing/">writing</a>.
    </p>
  </div>
</Base>
