---
import Base from '../../layouts/Base.astro';

const projects = [
  {
    href: '/projects/hallyu-press',
    status: 'corpus building',
    title: 'Hallyu in the Indian Press',
    line: 'A corpus of Indian English-language newspaper coverage of the Korean Wave, 2000–2026.',
  },
  {
    href: '/projects/buddhist-bridges',
    status: 'in analysis',
    title: 'Buddhist Bridges',
    line: 'A network dataset of the people who connected India and Korea through Buddhism.',
  },
  {
    href: '/projects/janghan',
    status: 'corpus building',
    title: 'Janghan (장한, 1927)',
    line: 'Digitizing a magazine written by kisaeng in colonial-period Seoul.',
  },
];
---

<Base
  title="Projects — Digital Humanities & Korean Studies | Mohd Bilal"
  description="Digital humanities projects on Korea and India: an Indian newspaper corpus on Hallyu, a network dataset of India–Korea Buddhist mediators, and the digitization of Janghan (1927)."
>
  <section class="band container">
    <h1 class="display-md rise">Projects</h1>

    <ul class="project-list">
      {
        projects.map((p, i) => (
          <li class={`rise rise-${i + 2}`}>
            <a class="project-card card" href={p.href}>
              <p class="caption-mono-sm status">{p.status}</p>
              <h2 class="display-xs">{p.title}</h2>
              <p class="body-md line">{p.line}</p>
              <span class="pill pill--sm">Read more →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <style>
    .project-list {
      list-style: none;
      margin: var(--s-2xl) 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-lg);
    }

    .project-list li:first-child {
      grid-column: 1 / -1;
    }

    @media (max-width: 767px) {
      .project-list {
        grid-template-columns: 1fr;
      }
    }

    .project-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-md);
      height: 100%;
      transition: border-color 0.2s ease;
    }

    .project-card:hover {
      border-color: var(--pill-border);
    }

    .project-card .status {
      margin: 0;
    }

    .project-card .line {
      margin: 0;
      color: var(--body);
    }

    .project-card .pill {
      margin-top: auto;
    }

    .project-card:hover .pill {
      border-color: var(--ink);
    }
  </style>
</Base>
