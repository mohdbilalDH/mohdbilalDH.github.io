---
// Project page anatomy per the dh-site-publish skill: identity, research question, the
// interactive object high on the page, context, evidence, findings, limits, data and citation.
import Project from '../../../layouts/Project.astro';
import ProjectHeader from '../../../components/ProjectHeader.astro';
import ProjectNav from '../../../components/ProjectNav.astro';
import ResearchQuestion from '../../../components/ResearchQuestion.astro';
import WaysIn from '../../../components/WaysIn.astro';
import ProjectFacts from '../../../components/ProjectFacts.astro';
import Apparatus from '../../../components/Apparatus.astro';
import JanghanCorpus from '../../../components/figures/JanghanCorpus.astro';
import JanghanWitnesses from '../../../components/figures/JanghanWitnesses.astro';
import JanghanLevels from '../../../components/figures/JanghanLevels.astro';
import JanghanRegisters from '../../../components/figures/JanghanRegisters.astro';
import JanghanBylines from '../../../components/figures/JanghanBylines.astro';
import JanghanPlaces from '../../../components/figures/JanghanPlaces.astro';
import j from '../../../data/janghan.json';
import places from '../../../data/janghan-places.json';
import corpus from '../../../data/janghan-corpus.json';
import { projects } from '../../../data/projects';

const p = projects.find((x) => x.slug === 'janghan')!;
const items = j.issue1.items + j.issue2.items;
const units = j.issue1.units + j.issue2.units;
const E = '/janghan';
const w1 = corpus.items.filter((i) => i.witnesses.length === 1).length;

const scale = [
  { n: String(items), unit: 'textual items' },
  { n: String(units), unit: 'editorial units' },
  { n: '2', unit: 'issues, 1927' },
  { n: String(j.contributors), unit: 'bylines' },
  { n: String(j.witnesses), unit: 'witnesses reconciled' },
  { n: String(j.place_mentions), unit: 'coded place mentions' },
];

const sections = [
  { id: 'question', label: 'Question' },
  { id: 'explore', label: 'Explore' },
  { id: 'evidence', label: 'Evidence' },
  { id: 'findings', label: 'Findings' },
  { id: 'places', label: 'Places' },
  { id: 'limits', label: 'Limits' },
  { id: 'data', label: 'Data & citation' },
];

const doors = [
  { href: `${E}/contents.html`, q: 'What was in it?', label: 'Contents, as each witness gives them', n: `${items} items` },
  { href: `${E}/contributors.html`, q: 'Who signed it?', label: 'Bylines, attribution status and cross-issue threads', n: `${j.contributors} bylines` },
  { href: `${E}/places.html`, q: 'Where does it name?', label: 'The full coded place register, excluded records included', n: `${j.place_mentions} mentions` },
  { href: `${E}/witnesses.html`, q: 'Who says so?', label: 'What each of the four sources attests, item by item', n: `${j.witnesses} witnesses` },
  { href: `${E}/issue/jh01.html`, q: 'Read the first issue', label: 'Every item of 창간호 with page position and witness status', n: `${j.issue1.items} items` },
  { href: `${E}/methods.html`, q: 'How was it made?', label: 'Coding scheme, versions, audit and licence' },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '長恨 (Changhan, 1927): reconstructed contents and attribution register',
  description:
    'Reconstructed corpus, structural encoding and coded spatial evidence for the two 1927 issues of the Korean magazine 長恨, built from four independent witnesses that disagree about the contents. Metadata and structure are published; page images and transcriptions are not.',
  creator: { '@type': 'Person', name: 'Mohd Bilal', affiliation: { '@type': 'CollegeOrUniversity', name: 'The Academy of Korean Studies' } },
  temporalCoverage: '1927',
  inLanguage: 'ko',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  version: 'Issue 1 corpus v3.3',
  isAccessibleForFree: true,
  variableMeasured: ['textual item', 'editorial unit', 'byline attribution', 'witness attestation', 'coded place mention'],
};
---
<Project title="長恨 (1927): the magazine the kisaeng made"
  description="A structural edition of 長恨 (Changhan, 1927), a Korean magazine published by and largely written by kisaeng, reconstructed from four independent witnesses that do not agree, with a register of its attributions and coded place evidence."
  citationTitle="長恨 (Changhan, 1927): Reconstructed Contents and Attribution Register"
  jsonld={jsonld}>
  <div class="wrap">

    <ProjectHeader project={p} scale={scale} />

    <figure class="covers">
      <div class="covers-imgs">
        <img src={`${E}/assets/jh01-cover.png`} width="900" height="1470" loading="eager"
             alt="Cover of 長恨 issue 1, January 1927: a woman seated inside a birdcage, with the title in two circular seals above." />
        <img src={`${E}/assets/jh02-cover.png`} width="411" height="606" loading="lazy"
             alt="Cover of 長恨 issue 2, February 1927: two women, one in hanbok and one in Western dress, holding hands beneath a rising sun." />
      </div>
      <figcaption class="caption">
        <b><span lang="ko">창간호</span></b>, 10 January 1927: <span lang="ko">동무여 생각하라 조롱 속에 이 몸을</span>,
        “Comrades, think of me here inside the cage,” from the 1927 original.
        <b><span lang="ko">2월호</span></b>, February 1927: a woman in hanbok and a woman in Western dress,
        hands joined beneath a rising sun, reproduced in the 2009 edition. These two covers are the only
        images this project is able to publish.
      </figcaption>
    </figure>
  </div>

  <ProjectNav sections={sections} />

  <div class="wrap">

    <ResearchQuestion status={`Status: the reconstruction is complete for Issue 1 and frozen at corpus v3.3. The spatial layer that this question ultimately depends on is coded for Issue 1 only, and no answer to it is offered yet.`}>
      <p>
        How are places distributed and differentiated across the authors, genres and textual voices of
        <span lang="ko">『장한』</span> (1927), and what does that spatial organisation reveal about the
        social world the magazine constructs?
      </p>
      <p class="rq-prior">
        None of which can be asked until a prior question is settled: <b>what was actually in the
        magazine?</b> Four surviving sources disagree, and this project is the answer to that.
      </p>
    </ResearchQuestion>

    <section class="section flush" id="explore" aria-labelledby="explore-h">
      <h2 id="explore-h"><span class="mark">Explore</span>The corpus, item by item</h2>
      <div class="prose">
        <p>
          Every textual item in both issues, in the order the reconstruction gives them. Recolour the
          same {items} items by who the byline names, by how secure that identification is, or by how
          many of the four witnesses attest the item. Select any cell to read its record and open it
          in the edition.
        </p>
      </div>
      <JanghanCorpus />
    </section>

    <WaysIn doors={doors}
      note="The edition is generated directly from the frozen corpus, so it cannot drift from the data. Every item, contributor and place carries its corpus id, its witness attestation and its own citation." />

    <section class="section" id="evidence" aria-labelledby="evidence-h">
      <h2 id="evidence-h"><span class="mark">Evidence</span>Why no two sources agree on what is in it</h2>
      <div class="prose">
        <p>
          <span lang="ko">長恨</span> was published by <span lang="ko">長恨社</span> in Kyŏngsŏng,
          colonial Seoul, in January and February 1927, with a kisaeng named as its publisher. Almost
          everything about its contents is contested. The published bibliography records
          {j.literature.issue1} and {j.literature.issue2} articles for the two issues; the Yonsei
          catalogue lists {j.yonsei.issue1} and {j.yonsei.issue2} entries; the 1927 table of contents
          lists a curated selection on a degraded scan; and a 2009 reprint numbers its own sequence.
        </p>
        <p>
          Those figures are not rival claims about the same thing. They count different units, chiefly
          poems printed inside other people's articles and prompts that carry several signed answers.
          This project holds the disagreement open instead of resolving it silently.
        </p>
      </div>
      <JanghanWitnesses />

      <div class="prose">
        <p>
          Counting the magazine depends entirely on what you agree to count, so the reconstruction
          records it at three levels, and keeping them apart is what makes the witnesses comparable at
          all.
        </p>
      </div>
      <dl class="ontology">
        <div class="ont-row"><dt>Bibliographic entry</dt>
          <dd>A record in an external catalogue. A witness to the contents, and never this project's own unit.</dd></div>
        <div class="ont-row"><dt>Editorial unit</dt>
          <dd>An item as the magazine presents it: one article, one column, or one prompt together with
            its answers. Counts are reported at this level. There are {units} across both issues.</dd></div>
        <div class="ont-row"><dt>Textual item</dt>
          <dd>A single continuous text with its own title or byline. Each answer to a prompt, and each
            poem printed inside another article, is one. There are {items}, of which {j.nested_items}
            sit nested inside a parent unit.</dd></div>
      </dl>
      <JanghanLevels />
    </section>

    <section class="section" id="findings" aria-labelledby="findings-h">
      <h2 id="findings-h"><span class="mark">Findings</span>What the reconstruction established</h2>
      <div class="prose">
        <p>
          The reconstruction was built to make a historical question answerable, and in the course of
          it the sources gave up five results of their own.
        </p>
      </div>

      <ol class="finds">
        <li>
          <div class="prose">
            <b>Most texts are kisaeng-attributed, and most of those identities are unestablished.</b>
            <p>
              {j.attribution.gisaeng} of {items} texts carry kisaeng attributions, but only
              {j.certainty.confirmed} identities across the whole corpus are confirmed;
              {j.certainty.probable} are probable, {j.certainty.carried_over_unchecked} are carried
              over from the inherited baseline without independent check, and
              {j.certainty.unresolved} remain unresolved. That gap is the most consequential thing
              the project has to report: it is the measure of what the colonial archive permits to be
              known about these women, and it is why a byline here is never silently converted into a
              person.
            </p>
          </div>
          <JanghanBylines />
        </li>
        <li>
          <div class="prose">
            <b>Issue 1 was printed in two registers, and no inventory had recorded it.</b>
            <p>
              A main upper block above a running bottom strip of short items, a layout the magazine's
              own table of contents marks. Page position is established for
              {j.issue1.register.upper + j.issue1.register.strip} of {j.issue1.items} Issue-1 items
              and left explicitly unknown for the rest, because it is read off the page or not
              asserted at all.
            </p>
          </div>
          <JanghanRegisters />
        </li>
        <li>
          <div class="prose">
            <b>The witnesses disagree for a countable reason.</b>
            <p>
              The sources are not careless. {j.nested_items} texts sit inside a parent unit, as poems
              printed within other articles or as answers to editorial prompts, so a catalogue that
              lists them separately and a magazine that presents them as one item both give an honest
              count of different things. {w1} items rest on a single witness alone.
            </p>
          </div>
        </li>
        <li>
          <div class="prose">
            <b>A serialised novel, and a phantom.</b>
            <p>
              Reading each candidate at the page recovered a two-part serial running across both
              issues that none of the existing inventories carried. Reconciling the Yonsei catalogue
              against the text removed one inherited record that turns out never to have existed, and
              re-identified another as a poem rather than an article.
            </p>
          </div>
        </li>
        <li>
          <div class="prose">
            <b>Contributors return across the two issues, with unequal certainty.</b>
            <p>
              {j.cross_issue_contributors} bylines recur out of {j.contributors}:
              {j.cross_issue_certainty.confirmed} confirmed by explicit serial numbering printed in
              the magazine, {j.cross_issue_certainty.probable} probable on byline evidence alone, and
              {j.cross_issue_certainty.unresolved} an unsigned recurring column whose narrating
              persona returns, which is continuity of a voice and not evidence of a person.
            </p>
          </div>
        </li>
      </ol>

      <Apparatus label="A complication kept in view, not resolved">
        <p>
          A kisaeng is named as publisher and most contributions are kisaeng-attributed, but the
          editorial work was done in practice by Ch'oe Hak-song
          (<span lang="ko">최학송, 崔鶴松</span>), a male writer associated with proletarian literature.
          <span lang="ko">長恨</span> is therefore neither straightforwardly written by kisaeng nor
          simply a magazine speaking for them. This project does not settle that by choosing a phrase:
          it records what a byline evidences, which is publication under a name, and marks how secure
          each identification is, so the question stays open to study.
        </p>
      </Apparatus>
    </section>

    <section class="section" id="places" aria-labelledby="places-h">
      <h2 id="places-h"><span class="mark">Places</span>The spatial layer, at evidence stage</h2>
      <div class="prose">
        <p>
          {j.place_mentions} mentions across {places.counted_places} places have been coded, for Issue
          1 only, under an eight-value function taxonomy. Issue 2 has not been coded at all. Competing
          explanations for the patterns in the evidence, among them genre, text length, page register,
          coding convention and editorial mediation, remain confounded and under test, and no answer
          to the research question is offered here. What is published is the evidence and the
          apparatus, including the part of it that cannot be drawn.
        </p>
      </div>
      <JanghanPlaces />
      <Apparatus label="Status and audit">
        <p>
          Issue-1 descriptive coding is complete and audited: a 20% stratified audit measured recall
          at 82% before correction and precision at 100%, with every miss traced to one mechanical
          defect in search coverage, which was repaired and re-run. Issue-2 place coding has not
          begun. Nothing in this section should be read as describing
          <span lang="ko">『장한』</span> as a whole.
        </p>
      </Apparatus>
    </section>

    <section class="section" id="limits" aria-labelledby="limits-h">
      <h2 id="limits-h"><span class="mark">Limits</span>What is withheld, and what is not claimed</h2>
      <div class="prose">
        <p>
          This project publishes no page images beyond the two covers above, and no transcriptions.
          The 2009 reprint that carries the only complete text of both issues is in copyright
          (<span lang="ko">보고사</span>), and the terms of the 1927 scan are unrecorded. What is
          published instead is a complete, item-level description of the magazine, which can be
          searched, counted, cited and contested without the text, and which is the part of the work
          that would otherwise exist only as a spreadsheet on one researcher's machine.
        </p>
        <ul class="limits">
          <li><b>Four witnesses, none of them ground truth.</b> Every item records which of them attests it, and the published bibliography counts at issue level only, so it can never be checked item by item.</li>
          <li><b>Two layers of transmission.</b> All machine-readable text comes from an optical reading of the 2009 reprint, which itself modernised spacing. Claims depending on the 1927 text's spacing, lineation or exact word counts are not made.</li>
          <li><b>Attribution is never authorship.</b> A byline is evidence that a text was published under a name. Pen names are not silently merged into people.</li>
          <li><b>Issue 2 is a working layer,</b> with no surviving 1927 scan, so page register is unknown throughout it and place coding has not begun.</li>
          <li><b>Voice measures are not fingerprints.</b> Script density and politeness were computed and retained, but profiles of the same pen name proved unstable across the two issues, so they are reported as a negative result rather than published as a browsable table.</li>
        </ul>
      </div>
    </section>

    <section class="section" id="data" aria-labelledby="facts-h">
      <ProjectFacts
        project={p}
        duration="Corpus work from 2025; Issue 1 frozen at v3.3 in August 2026; the edition interface first generated August 2026."
        resources={[
          { href: '/janghan/', label: 'The edition', note: '171 generated pages' },
          { href: '/projects/janghan/data/', label: 'Method and data', note: 'coding scheme, audit, versions, figure grammar' },
          { href: '/janghan/data/v1/text_items.json', label: 'text_items.json', note: 'all 98 items with witnesses', download: true },
          { href: '/janghan/data/v1/contributors.json', label: 'contributors.json', download: true },
          { href: '/janghan/data/v1/places.json', label: 'places.json', note: 'place list v1.1', download: true },
          { href: '/janghan/data/v1/place_mentions.json', label: 'place_mentions.json', note: 'coded evidence v1.2', download: true },
        ]}
        licence="Project metadata, structure and coded evidence: CC BY 4.0. Source texts and page images are not published and remain with their rights holders; the 2009 reprint is © 보고사."
        citation="Bilal, Mohd. 長恨 (Changhan, 1927): Reconstructed Contents and Attribution Register. Issue 1 corpus v3.3. The Academy of Korean Studies, 2026."
        url="https://mohdbilaldh.github.io/projects/janghan/" />
    </section>
  </div>
</Project>
<style>
  .covers { margin: 0 0 8px; }
  .covers-imgs { display: flex; gap: 28px; align-items: flex-start; flex-wrap: wrap; }
  .covers-imgs img { display: block; height: auto; max-height: 340px; width: auto; max-width: 46%; background: var(--white); }
  .covers figcaption { max-width: var(--w-measure); margin-top: 14px; }
  .flush { margin-top: 0; }
  .limits { max-width: var(--w-measure); }
  .limits li { margin-bottom: 10px; }
  :global(.rq-prior) { font-size: 0.72em !important; line-height: 1.55 !important; color: var(--text) !important; font-family: var(--f-ui) !important; margin-top: 18px !important; }
  @media (max-width: 640px) { .covers-imgs img { max-width: 100%; max-height: 260px; } }
</style>
