---
import Project from '../../../layouts/Project.astro';
import ProjectHeader from '../../../components/ProjectHeader.astro';
import ProjectFacts from '../../../components/ProjectFacts.astro';
import Apparatus from '../../../components/Apparatus.astro';
import ExploreDoor from '../../../components/ExploreDoor.astro';
import JanghanWitnesses from '../../../components/figures/JanghanWitnesses.astro';
import JanghanCorpus from '../../../components/figures/JanghanCorpus.astro';
import JanghanLevels from '../../../components/figures/JanghanLevels.astro';
import JanghanRegisters from '../../../components/figures/JanghanRegisters.astro';
import JanghanBylines from '../../../components/figures/JanghanBylines.astro';
import JanghanPlaces from '../../../components/figures/JanghanPlaces.astro';
import j from '../../../data/janghan.json';
import places from '../../../data/janghan-places.json';
import { projects } from '../../../data/projects';

const p = projects.find((x) => x.slug === 'janghan')!;
const items = j.issue1.items + j.issue2.items;
const units = j.issue1.units + j.issue2.units;
const E = '/janghan';

const scale = [
  { n: String(items), unit: 'textual items' },
  { n: String(units), unit: 'editorial units' },
  { n: '2', unit: 'issues, 1927' },
  { n: String(j.contributors), unit: 'bylines' },
  { n: String(j.witnesses), unit: 'witnesses reconciled' },
  { n: String(j.place_mentions), unit: 'coded place mentions' },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '長恨 (Changhan, 1927): reconstructed contents and attribution register',
  description:
    'Reconstructed corpus, structural encoding and coded spatial evidence for the two 1927 issues of the Korean magazine 長恨, built from four independent witnesses that disagree about the contents. Metadata and structure are published; page images and transcriptions are not.',
  creator: { '@type': 'Person', name: 'Mohd Bilal', affiliation: { '@type': 'CollegeOrUniversity', name: 'The Academy of Korean Studies' } },
  temporalCoverage: '1927',
  inLanguage: 'ko',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  version: 'Issue 1 corpus v3.3',
  isAccessibleForFree: true,
  variableMeasured: ['textual item', 'editorial unit', 'byline attribution', 'witness attestation', 'coded place mention'],
};
---
<Project title="長恨 (1927): the magazine the kisaeng made"
  description="A structural edition of 長恨 (Changhan, 1927), a Korean magazine published by and largely written by kisaeng, reconstructed from four independent witnesses that do not agree, with a register of its attributions and coded place evidence."
  citationTitle="長恨 (Changhan, 1927): Reconstructed Contents and Attribution Register"
  jsonld={jsonld}>
  <div class="wrap">

    <ProjectHeader project={p} scale={scale} />

    <figure class="covers">
      <div class="covers-imgs">
        <img src={`${E}/assets/jh01-cover.png`} width="900" height="1470" loading="eager"
             alt="Cover of 長恨 issue 1, January 1927: a woman seated inside a birdcage, with the title in two circular seals above." />
        <img src={`${E}/assets/jh02-cover.png`} width="411" height="606" loading="lazy"
             alt="Cover of 長恨 issue 2, February 1927: two women, one in hanbok and one in Western dress, holding hands beneath a rising sun." />
      </div>
      <figcaption class="caption">
        <b><span lang="ko">창간호</span></b>, 10 January 1927: <span lang="ko">동무여 생각하라 조롱 속에 이 몸을</span>,
        “Comrades, think of me here inside the cage,” from the 1927 original.
        <b><span lang="ko">2월호</span></b>, February 1927: a woman in hanbok and a woman in Western dress,
        hands joined beneath a rising sun, reproduced in the 2009 edition. These two covers are the only
        images this project is able to publish.
      </figcaption>
    </figure>

    <section class="section">
      <h2><span class="mark">Why it matters</span>Kisaeng as writers, not as subject matter</h2>
      <div class="prose">
        <p>
          <span lang="ko">長恨</span> was published by <span lang="ko">長恨社</span> in Kyŏngsŏng, colonial
          Seoul, in January and February 1927, with a kisaeng named as its publisher. Of the {items} texts
          this project records across both issues, {j.attribution.gisaeng} are kisaeng-attributed: they
          appear under the names, pen names or self-descriptions of women from the registered, stigmatised
          profession the magazine was about. Alongside them are essays by outside contributors, editorial
          columns, fiction, poems and reader correspondence. It is a commercial magazine, not a private
          album, and it is one of very few places in the colonial Korean press where women of that
          profession write rather than being written about.
        </p>
      </div>
      <Apparatus label="A complication kept in view, not resolved">
        <p>
          A kisaeng is named as publisher and most contributions are kisaeng-attributed, but the editorial
          work was done in practice by Ch'oe Hak-song (<span lang="ko">최학송, 崔鶴松</span>), a male writer
          associated with proletarian literature. <span lang="ko">長恨</span> is therefore neither
          straightforwardly written by kisaeng nor simply a magazine speaking for them. This project does not
          settle that by choosing a phrase. It records what a byline evidences, which is publication under a
          name, and marks how secure each identification is, so the question stays open to study.
        </p>
      </Apparatus>
      <div class="prose">
        <p>
          None of that can be studied, however, until a prior question is answered: what was actually in the
          magazine?
        </p>
      </div>
    </section>

    <section class="section">
      <h2><span class="mark">The problem</span>No two sources agree on what is in it</h2>
      <div class="prose">
        <p>
          Almost everything about <span lang="ko">長恨</span>'s contents is contested. The published
          bibliography records {j.literature.issue1} and {j.literature.issue2} articles for the two issues;
          the Yonsei catalogue lists {j.yonsei.issue1} and {j.yonsei.issue2} entries; the 1927 table of
          contents lists a curated selection on a degraded scan; and a 2009 reprint numbers its own sequence.
        </p>
        <p>
          Those figures are not rival claims about the same thing. They count different units, chiefly poems
          printed inside other people's articles and prompts that carry several signed answers. This project
          holds the disagreement open instead of resolving it silently, and shows how each witness divides the
          magazine.
        </p>
      </div>
      <JanghanWitnesses />
      <JanghanCorpus />
    </section>

    <section class="section">
      <h2><span class="mark">The method</span>Three levels, then a reconstruction</h2>
      <div class="prose">
        <p>
          Counting the magazine depends entirely on what you agree to count, so the reconstruction records it
          at three levels, and keeping them apart is what makes the witnesses comparable at all.
        </p>
      </div>
      <dl class="ontology">
        <div class="ont-row"><dt>Bibliographic entry</dt>
          <dd>A record in an external catalogue. A witness to the contents, and never this project's own unit.</dd></div>
        <div class="ont-row"><dt>Editorial unit</dt>
          <dd>An item as the magazine presents it: one article, one column, or one prompt together with its
            answers. Counts are reported at this level. There are {units} across both issues.</dd></div>
        <div class="ont-row"><dt>Textual item</dt>
          <dd>A single continuous text with its own title or byline. Each answer to a prompt, and each poem
            printed inside another article, is one. There are {items}, of which {j.nested_items} sit nested
            inside a parent unit.</dd></div>
      </dl>
      <JanghanLevels />

      <div class="prose">
        <p>On that footing, the contents were rebuilt in five steps.</p>
        <ol class="steps">
          <li><b>An inherited baseline.</b> 58 records across both issues, with approximate page ranges and no external check.</li>
          <li><b>Reading every candidate at source.</b> Three earlier passes had disagreed on how many articles
            were recoverable. Re-reading each at the page settled it, and turned up a two-part serialised novel
            that no inventory had recorded.</li>
          <li><b>Adding an independent witness.</b> The Yonsei catalogue was reconciled against the text. One
            inherited record proved to be a phantom that had never existed; another was re-identified as a poem
            rather than an article.</li>
          <li><b>Recovering the page itself.</b> The 1927 scan showed that Issue 1 is set in two registers, a
            main upper block above a running bottom strip of short items, which the magazine's own table of
            contents marks and no prior inventory had recorded.</li>
          <li><b>Freezing Issue 1, then reconciling Issue 2.</b> Issue 1 is frozen at {j.issue1.units} editorial
            units, so every figure here can be checked against the exact state of the evidence it came from.
            Issue 2 is reconciled to {j.issue2.units} but remains a working layer: no 1927 scan of it is known
            to survive.</li>
        </ol>
      </div>
    </section>

    <section class="section">
      <h2><span class="mark">What it revealed</span>Five results of the reconstruction</h2>
      <div class="prose">
        <p>
          These are results of the reconstruction itself. The spatial analysis the project was built to make
          possible is a separate, later question, and is at evidence stage.
        </p>
      </div>

      <ol class="finds">
        <li>
          <div class="prose">
            <b>Issue 1 was printed in two registers.</b>
            <p>
              A main upper block and a running bottom strip of short items, a layout the magazine's own table
              of contents marks and no prior inventory had recorded. Page position is established for
              {j.issue1.register.upper + j.issue1.register.strip} of {j.issue1.items} Issue-1 items
              ({j.issue1.register.upper} upper, {j.issue1.register.strip} strip) and is left explicitly unknown
              for the rest, because it is read off the page or not asserted at all.
            </p>
          </div>
          <JanghanRegisters />
        </li>
        <li>
          <div class="prose">
            <b>A serialised novel that no inventory recorded.</b>
            <p>
              Reading each candidate at the page, rather than trusting the inherited list, recovered a two-part
              serial running across both issues that none of the existing inventories carried.
            </p>
          </div>
        </li>
        <li>
          <div class="prose">
            <b>A phantom record, and a poem filed as an article.</b>
            <p>
              Reconciling the Yonsei catalogue against the text removed one inherited record that turns out
              never to have existed, and re-identified another as a poem rather than an article.
            </p>
          </div>
        </li>
        <li>
          <div class="prose">
            <b>The witnesses disagree for a reason, and the reason is countable.</b>
            <p>
              The sources are not careless. They divide the magazine differently: {j.nested_items} texts sit
              inside a parent unit, as poems printed within other articles or as answers to editorial prompts,
              so a catalogue that lists them separately and a magazine that presents them as one item both give
              an honest count of different things.
            </p>
          </div>
        </li>
        <li>
          <div class="prose">
            <b>Most texts are kisaeng-attributed, and most of those identities are unestablished.</b>
            <p>
              {j.attribution.gisaeng} of {items} texts carry kisaeng attributions, but only
              {j.certainty.confirmed} identities across the whole corpus are confirmed;
              {j.certainty.probable} are probable, {j.certainty.carried_over_unchecked} are carried over from
              the inherited baseline without independent check, and {j.certainty.unresolved} remain unresolved.
              {j.cross_issue_contributors} bylines recur across both issues out of {j.contributors}, and they
              recur with unequal certainty: {j.cross_issue_certainty.confirmed} confirmed by explicit serial
              numbering printed in the magazine, {j.cross_issue_certainty.probable} probable on byline evidence
              alone, and {j.cross_issue_certainty.unresolved} an unsigned recurring column whose narrating
              persona returns, which is continuity of a voice and not evidence of a person.
            </p>
          </div>
          <JanghanBylines />
        </li>
      </ol>
    </section>

    <section class="section">
      <h2><span class="mark">Places</span>The question the reconstruction was built to make answerable</h2>
      <div class="prose">
        <p>
          The reconstruction is not an end in itself. It exists so that a historical question can be asked of
          the magazine: how are places distributed and differentiated across the authors, genres and textual
          voices of <span lang="ko">『장한』</span>, and what does that spatial organisation reveal about the
          social world the magazine constructs?
        </p>
        <p>
          That question is at evidence stage. {j.place_mentions} mentions across {places.counted_places}
          places have been coded, for Issue 1 only, under an eight-value function taxonomy. Issue 2 has not
          been coded at all. Competing explanations for the patterns in the evidence, among them genre, text
          length, page register, coding convention and editorial mediation, remain confounded and under test,
          and no answer is offered here. What is published is the evidence and the apparatus, including the
          part of it that cannot be drawn.
        </p>
      </div>
      <JanghanPlaces />
      <Apparatus label="Status of the spatial layer">
        <p>
          Issue-1 descriptive coding is complete and audited: a 20% stratified audit measured recall at 82%
          before correction and precision at 100%, with every miss traced to one mechanical defect in search
          coverage, which was repaired and re-run. Issue-2 place coding has not begun. Nothing on this page
          should be read as describing <span lang="ko">『장한』</span> as a whole.
        </p>
      </Apparatus>
    </section>

    <section class="section">
      <h2><span class="mark">Rights</span>What is published, what is withheld, and why</h2>
      <div class="prose">
        <p>
          This project publishes no page images beyond the two covers above, and no transcriptions. The 2009
          reprint that carries the only complete text of both issues is in copyright
          (<span lang="ko">보고사</span>), and the terms of the 1927 scan are unrecorded. Asking a reader to
          take that on trust would be worse than saying it plainly, so it is said here rather than in a
          footnote on an item page.
        </p>
        <p>
          What is published instead is a complete, item-level description of the magazine: every textual item
          with its title, byline, pages, editorial unit, genre, page register where it can be established, and
          which of the four witnesses attests it; every byline with its attribution status and its threads
          across the two issues; and every coded place mention with its function, its status and the coder's
          note. That description is the scholarly object. It can be searched, counted, cited and contested
          without the text, and it is the part of the work that would otherwise exist only as a spreadsheet on
          one researcher's machine.
        </p>
      </div>
    </section>

    <section class="section">
      <h2><span class="mark">Explore</span>The edition itself</h2>
      <div class="prose">
        <p>
          The research interface is generated directly from the frozen corpus, so it cannot drift from the
          data. Every item, contributor and place opens to the evidence behind it and carries its own citation.
        </p>
      </div>
      <ExploreDoor href={p.explore!.href} label={p.explore!.label} blurb={p.explore!.blurb} />
      <div class="doorlist">
        <a href={`${E}/contents.html`}><b>Contents</b><span>The same magazine as the 1927 list, the catalogue and this reconstruction give it</span></a>
        <a href={`${E}/contributors.html`}><b>Contributors</b><span>Every byline, its attribution status, and its threads across the two issues</span></a>
        <a href={`${E}/places.html`}><b>Places</b><span>The full coded register, including the records excluded by rule</span></a>
        <a href={`${E}/methods.html`}><b>Method and data</b><span>Versioned JSON datasets, coding scheme, audit and licence</span></a>
      </div>
    </section>

    <section class="section">
      <h2><span class="mark">Limits</span>What this project does not claim</h2>
      <div class="prose">
        <ul class="limits">
          <li><b>Four witnesses, none of them ground truth.</b> Every item records which of them attests it, and the published bibliography counts at issue level only, so it can never be checked item by item.</li>
          <li><b>Two layers of transmission.</b> All machine-readable text comes from an optical reading of the 2009 reprint, which itself modernised spacing. Claims depending on the 1927 text's spacing, lineation or exact word counts are not made.</li>
          <li><b>Attribution is never authorship.</b> A byline is evidence that a text was published under a name. Pen names are not silently merged into people.</li>
          <li><b>Issue 2 is a working layer,</b> with no surviving 1927 scan, so page register is unknown throughout it and place coding has not begun.</li>
          <li><b>Voice measures are not fingerprints.</b> Script density and politeness were computed and retained, but profiles of the same pen name proved unstable across the two issues, so they are reported as a negative result rather than published as a browsable table.</li>
        </ul>
        <p class="small muted">
          Full method, coding scheme, dataset versions and audit are on the
          <a href="/projects/janghan/data/">data page</a>.
        </p>
      </div>
    </section>

    <ProjectFacts
      project={p}
      duration="Corpus work from 2025; Issue 1 frozen at v3.3 in August 2026; the edition interface first generated August 2026."
      resources={[
        { href: '/janghan/', label: 'The edition', note: '171 generated pages' },
        { href: '/janghan/data/v1/text_items.json', label: 'text_items.json', note: 'all 98 items with witnesses', download: true },
        { href: '/janghan/data/v1/contributors.json', label: 'contributors.json', download: true },
        { href: '/janghan/data/v1/places.json', label: 'places.json', note: 'place list v1.1', download: true },
        { href: '/janghan/data/v1/place_mentions.json', label: 'place_mentions.json', note: 'coded evidence v1.2', download: true },
        { href: '/janghan/methods.html', label: 'Method and data', note: 'coding scheme, audit, versions' },
      ]}
      licence="Project metadata, structure and coded evidence: CC BY 4.0. Source texts and page images are not published and remain with their rights holders; the 2009 reprint is © 보고사."
      citation="Bilal, Mohd. 長恨 (Changhan, 1927): Reconstructed Contents and Attribution Register. Issue 1 corpus v3.3. The Academy of Korean Studies, 2026."
      url="https://mohdbilaldh.github.io/projects/janghan/" />
  </div>
</Project>
<style>
  .covers { margin: 0 0 44px; }
  .covers-imgs { display: flex; gap: 28px; align-items: flex-start; flex-wrap: wrap; }
  .covers-imgs img { display: block; height: auto; max-height: 360px; width: auto; max-width: 46%; background: var(--white); }
  .covers figcaption { max-width: var(--w-measure); margin-top: 14px; }
  .limits { max-width: var(--w-measure); }
  .limits li { margin-bottom: 10px; }
  .steps { max-width: var(--w-measure); }
  .steps li { margin-bottom: 12px; }
  .doorlist { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; max-width: var(--w-measure); margin-top: 16px; }
  .doorlist a { display: block; padding: 14px 18px; border: 1px solid var(--hairline); background: var(--white); text-decoration: none; color: inherit; transition: border-color var(--ease); }
  .doorlist a:hover { border-color: var(--navy); text-decoration: none; color: inherit; }
  .doorlist b { display: block; font: 700 16px/1.3 var(--f-title); color: var(--navy); margin-bottom: 4px; }
  .doorlist span { display: block; font: 400 13px/1.6 var(--f-ui); color: var(--muted); }
  @media (max-width: 640px) {
    .covers-imgs img { max-width: 100%; max-height: 260px; }
    .doorlist { grid-template-columns: 1fr; }
  }
</style>
