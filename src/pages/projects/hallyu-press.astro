---
import Base from '../../layouts/Base.astro';
import hallyu from '../../data/hallyu.json';

const periods = hallyu.proquest_periods;
const max = Math.max(...periods.map((p) => p.count));
---

<Base
  title="Hallyu in the Indian Press — an Indian Newspaper Corpus, 2000–2026"
  description="Building an Indian newspaper corpus of Korean Wave coverage: The Hindu, Times of India, and Indian Express, 2000–2026. Corpus in progress; framing analysis to follow."
>
  <section class="band container">
    <p class="caption-mono-sm rise">Status: corpus building — in progress</p>
    <h1 class="display-md rise rise-2">Hallyu in the Indian Press, 2000–2026</h1>

    <div class="prose lede">
      <p class="body-lg rise rise-3">
        How has the Indian press written about the Korean Wave? This project is
        building an Indian newspaper corpus to answer that at scale: English-language
        coverage of Hallyu and BTS from 2000 to 2026, drawn from The Hindu, the Times
        of India, and the Indian Express.
      </p>
      <p class="body-md rise rise-3">
        The goal is a corpus complete enough that claims about "how Indian media frames
        Korea" can be tested rather than asserted — framing, volume, and vocabulary,
        measured across two and a half decades.
      </p>
    </div>
  </section>

  <div class="container"><hr class="hr" /></div>

  <section class="band container reveal">
    <h2 class="display-sm">Coverage over time</h2>

    <figure class="figure chart-frame">
      <div class="chart" role="img" aria-label={`Hallyu press coverage by period: ${periods.map((p) => `${p.label}, ${p.count} articles`).join('; ')}`}>
        {
          periods.map((p) => (
            <div class="row">
              <span class="caption-mono-sm label">{p.label}</span>
              <div class="track">
                <div class="bar" style={`width: ${Math.max((p.count / max) * 100, 0.75)}%`} />
              </div>
              <span class="caption-mono-sm value">{p.count.toLocaleString('en-US')}</span>
            </div>
          ))
        }
      </div>
      <figcaption class="caption-mono-sm">
        Hallyu/K-wave press objects · ProQuest print editions (TOI · HT · IE) · searched 2026-08-18
      </figcaption>
    </figure>
  </section>

  <div class="container"><hr class="hr" /></div>

  <section class="band container reveal">
    <h2 class="display-sm">What's next</h2>
    <div class="prose next-body">
      <p class="body-md">
        The corpus is under construction; analysis and figures will appear here as
        they stabilize.
      </p>
    </div>
  </section>

  <div class="container"><hr class="hr" /></div>

  <section class="band container reveal">
    <div class="prose">
      <p class="body-md contact-line">
        Working on Hallyu reception or Indian media yourself? I'm glad to talk about
        the data — <a href="mailto:mohdbilalkhan2017@gmail.com">email me</a>.
      </p>
      <a class="pill" href="/projects/buddhist-bridges">Buddhist Bridges →</a>
    </div>
  </section>

  <style>
    .lede {
      margin-top: var(--s-2xl);
    }

    .lede .body-md {
      color: var(--body);
    }

    .chart-frame {
      margin: var(--s-2xl) 0 0;
    }

    .chart {
      display: grid;
      gap: var(--s-lg);
    }

    .row {
      display: grid;
      grid-template-columns: 96px 1fr 64px;
      align-items: center;
      gap: var(--s-lg);
    }

    .track {
      height: 28px;
      display: flex;
      align-items: center;
    }

    .bar {
      height: 100%;
      background: var(--accent);
      border-radius: 2px;
      min-width: 2px;
    }

    .row:nth-child(1) .bar {
      background: var(--accent-soft);
    }

    .row:nth-child(2) .bar {
      background: var(--accent-mid);
    }

    .value {
      text-align: right;
      color: var(--body);
    }

    @media (max-width: 560px) {
      .row {
        grid-template-columns: 72px 1fr 56px;
        gap: var(--s-sm);
      }
    }

    .next-body p,
    .contact-line {
      margin: 0;
    }

    .contact-line {
      margin-bottom: var(--s-lg);
    }
  </style>
</Base>
