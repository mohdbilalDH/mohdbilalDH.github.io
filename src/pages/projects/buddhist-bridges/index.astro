---
// Project page anatomy per the dh-site-publish skill: identity, research question, the
// interactive object high on the page, evidence, findings, limits, data and citation.
import Project from '../../../layouts/Project.astro';
import ProjectHeader from '../../../components/ProjectHeader.astro';
import ProjectNav from '../../../components/ProjectNav.astro';
import ResearchQuestion from '../../../components/ResearchQuestion.astro';
import WaysIn from '../../../components/WaysIn.astro';
import ProjectFacts from '../../../components/ProjectFacts.astro';
import Apparatus from '../../../components/Apparatus.astro';
import Chronology from '../../../components/figures/Chronology.astro';
import DirectionChart from '../../../components/figures/DirectionChart.astro';
import Corridor from '../../../components/figures/Corridor.astro';
import BBSilence from '../../../components/figures/BBSilence.astro';
import MechanismChart from '../../../components/figures/MechanismChart.astro';
import Residents from '../../../components/figures/Residents.astro';
import BBNetwork from '../../../components/figures/BBNetwork.astro';
import core from '../../../data/core.json';
import { projects } from '../../../data/projects';
import { personHref, CONFIDENCE_LEGEND } from '../../../data/bb';

const c = core.counts;
const p = projects.find((x) => x.slug === 'buddhist-bridges')!;

const scale = [
  { n: String(c.people_carried), unit: 'documented mediators' },
  { n: '6', unit: 'cohorts, 300–2026' },
  { n: String(c.sources), unit: 'graded sources' },
  { n: String(c.travels), unit: 'travels' },
  { n: String(c.texts), unit: 'texts' },
  { n: String(c.institutions), unit: 'institutions' },
  { n: String(c.events), unit: 'events' },
];

const sections = [
  { id: 'question', label: 'Question' },
  { id: 'explore', label: 'Explore' },
  { id: 'evidence', label: 'Evidence' },
  { id: 'findings', label: 'Findings' },
  { id: 'limits', label: 'Limits' },
  { id: 'data', label: 'Data & citation' },
];

const X = '/projects/buddhist-bridges/explore/';
const doors = [
  { href: `${X}`, q: 'Where are the five bridges?', label: 'The whole span, cohort by cohort', n: '182 marks' },
  { href: `${X}?view=moved`, q: 'Who actually moved?', label: 'Journeys with a documented direction', n: `${c.travels} travels` },
  { href: `${X}?view=texts`, q: 'What crossed without travel?', label: 'Texts and translations as the carrier', n: `${c.texts} texts` },
  { href: `${X}?view=institutions`, q: 'Who organises it now?', label: 'Orders, universities and programmes', n: `${c.institutions} institutions` },
  { href: `${X}#register`, q: 'Show me everyone', label: 'The searchable register of all carried mediators', n: `${c.people_carried} people` },
  { href: personHref('P-0001'), q: 'One life in full', label: "Hyech'o, the best documented life of the balanced era" },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Buddhist Bridges: India–Korea Buddhist Mediators Dataset (v3.0)',
  description:
    'Source-graded prosopography of documented mediators of India–Korea Buddhist exchange, 300–2026 CE. 43 carried people, 41 travels, 30 texts, 31 institutions and 19 events on 187 graded sources, with documented negatives retained.',
  creator: { '@type': 'Person', name: 'Mohd Bilal', affiliation: { '@type': 'CollegeOrUniversity', name: 'The Academy of Korean Studies' } },
  license: 'https://creativecommons.org/licenses/by/4.0/',
  version: '3.0',
  datePublished: '2026-08-17',
  temporalCoverage: '0300/2026',
  isAccessibleForFree: true,
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://mohdbilaldh.github.io/data/people.json' },
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://mohdbilaldh.github.io/data/timeline.json' },
  ],
};
---
<Project title="Buddhist Bridges: five bridges, one silence"
  description="Who mediated Buddhist exchange between India and Korea, 300–2026? A source-graded prosopography of 43 documented mediators: five short-lived bridges and one five-hundred-year silence, with a page for every person."
  citationTitle="Five Bridges, One Silence: Documented Mediators of India–Korea Buddhist Exchange, 300–2026"
  jsonld={jsonld}>
  <div class="wrap">
    <ProjectHeader project={p} scale={scale} />
  </div>

  <ProjectNav sections={sections} />

  <div class="wrap">
    <ResearchQuestion status="Status: the dataset is frozen at v3.0 and checksummed. All analysis is descriptive; the answer below is a periodisation of the documented record, not a claim about everything that ever happened.">
      <p>
        Was there ever a continuous Buddhist bridge between India and Korea, and if not, what does
        the documented record show instead?
      </p>
    </ResearchQuestion>

    <section class="section flush" id="explore" aria-labelledby="explore-h">
      <h2 id="explore-h"><span class="mark">Explore</span>Sixteen centuries, cohort by cohort</h2>
      <div class="prose">
        <p>
          Every carried record on one axis. Select an era to open its people in place, with lifelines
          drawn at the precision each source actually supports, and select a person to read their
          full cited record.
        </p>
      </div>
      <Chronology />
      <Apparatus label="Reading the marks, here and on every figure below">
        <p>{CONFIDENCE_LEGEND}</p>
        <p>
          Solid marks are explicitly dated records; dashed marks are floruit-derived windows; hatching
          means the record rests on a single source. A record without a safe date is listed in the
          register and never placed on an axis. The full grammar is on the
          <a href="/projects/buddhist-bridges/data/#grammar-h">data page</a>.
        </p>
      </Apparatus>
    </section>

    <WaysIn doors={doors}
      note="Every claim on every route opens to its record id and source key. The register is searchable by name, era and mediation type, and each of the 43 mediators has a citable page of their own." />

    <section class="section" id="evidence" aria-labelledby="evidence-h">
      <h2 id="evidence-h"><span class="mark">Evidence</span>Four things the record shows</h2>

      <h3>The direction inverts once, and never again</h3>
      <div class="prose">
        <p>
          Before 900 the bridge was made of journeys, and it ran both ways. Of eighteen carried
          mediators in the first cohort, eight moved toward India and eight carried Buddhism toward
          Korea. No later era is balanced. From Koryŏ onward India comes to Korea: first in one
          person, the monk Dhyānabhadra, then in texts, then in institutions. Two-way movement does
          not return until the 1990s.
        </p>
      </div>
      <DirectionChart />
      <div class="prose">
        <p>
          Journeys are only drawn where the record names the stations along the way. Of {c.travels}
          travels, {c.journeys_routed} have a route that can be reconstructed from the sources; the
          rest are known to have happened without a recoverable path, and nothing is interpolated to
          fill them in. That is also why this project publishes no map: eight routed journeys across
          sixteen centuries would make a map that looked far more certain than the evidence behind it.
        </p>
      </div>
      <Corridor />
      <Apparatus label="The evidence, close up">
        <p>
          The best documented life of the balanced era is Hyech'o (<span lang="ko">혜초, 慧超</span>,
          704–787), who sailed to India around 719 and walked back through Kashmir, Persia and Central
          Asia. His <i>Wang ochŏnch'ukkuk chŏn</i>, the only surviving eighth-century East Asian
          account of India, spent a millennium in the Dunhuang cave library and was first exhibited in
          Korea in 2010. <a href={personHref('P-0001')}>Open his record →</a>
        </p>
      </Apparatus>

      <h3>Five hundred years in which nothing meets the bar</h3>
      <div class="prose">
        <p>
          For the whole of Chosŏn, 1392 to 1900, no person, journey, text or institution meets the
          evidence bar. Eleven candidates were examined and all were excluded, as the Neo-Confucian
          state closed the channels Buddhism had used. Between the enshrinement of Dhyānabhadra's
          relics in 1370 and the next documented event, a delegation of 1981, lie 611 years.
        </p>
      </div>
      <BBSilence />
      <Apparatus label="What a zero does and does not mean">
        <p>
          Following the practice of the Prosopography of the Byzantine World: it should never be
          assumed that what a dataset does not contain does not exist. This zero is a finding under
          stated inclusion criteria, and it is documented rather than asserted, which is why the
          excluded candidates stay in the dataset and are drawn above.
        </p>
      </Apparatus>

      <h3>Each rebuilt bridge is made of a different material</h3>
      <div class="prose">
        <p>
          The ancient bridge was made of people who travelled. The colonial-era bridge was made of
          paper: four of its six mediators were not Buddhists, both attempted pilgrimages went
          unrealised, and what crossed was text, above all Tagore in Korean translation. The present
          bridge is institutional, carried by orders, universities and pilgrimage programmes; movement
          has returned, and the record includes its first women.
        </p>
      </div>
      <MechanismChart />
      <Apparatus label="The evidence, close up">
        <p>
          Two documents anchor the colonial chapter: the six-line message Tagore sent the
          <i>Tonga ilbo</i> in 1929, remembered as “The Lamp of the East,” and the fifteen-line poem
          later circulated under the same title, which the dataset records as a composite fabrication.
          One event closes the longer arc: in 2024 relics from Hoeamsa, where Dhyānabhadra's remains
          were enshrined in 1370, returned to Korea from the Boston Museum of Fine Arts.
          <a href={personHref('P-0030')}>Tagore's record →</a>
        </p>
      </Apparatus>
      <div class="prose">
        <p>One role recurs in every era of contact and in no other: the mediator who stays.</p>
      </div>
      <Residents />

      <h3>Where the record supports a network, and where it does not</h3>
      <div class="prose">
        <p>
          Two periods in sixteen centuries leave enough connected records to draw as a network, and
          they are shaped differently. The Koryŏ circle is one hub with spokes: everything runs
          through Dhyānabhadra, because the era does. The modern web has no single hub at all, and
          forty-two of its forty-seven ties are institutional, which is the finding rather than a
          by-product of the drawing.
        </p>
      </div>
      <BBNetwork />
    </section>

    <section class="section" id="findings" aria-labelledby="findings-h">
      <h2 id="findings-h"><span class="mark">Findings</span>What this amounts to</h2>
      <div class="prose">
        <p>
          The documented record shows no continuous bridge. It shows five short-lived bridges built
          by different kinds of people in different directions, and one interruption five centuries
          long in which no person, journey, text or institution meets the evidence bar. Three things
          follow from that.
        </p>
        <ol class="findlist">
          <li>
            <b>The relationship has a periodisation, and it is not the one usually told.</b> It is
            told either as myth, in which contact is ancient and unbroken, or as modern diplomacy, in
            which it begins in the 1970s. The record supports neither. It gives five distinct cohorts
            with a five-century interruption that has to be passed over in silence by any account of
            unbroken transmission.
          </li>
          <li>
            <b>Transmission survived without contact.</b> What crossed during and after the
            interruption was lineage and print, not people. That is a result about how religious
            traditions persist, and it is legible here only because the absence was recorded as data
            rather than left as a gap.
          </li>
          <li>
            <b>A small, fully graded dataset can carry an argument a large scraped one cannot.</b>
            {c.people_carried} people with {c.sources} graded sources support a periodisation claim
            precisely because every record can be traced, every exclusion inspected, and every
            uncertain date left uncertain.
          </li>
        </ol>
      </div>
    </section>

    <section class="section" id="limits" aria-labelledby="limits-h">
      <h2 id="limits-h"><span class="mark">Limits</span>What this project does not claim</h2>
      <div class="prose">
        <ul class="limits">
          <li><b>All analysis is descriptive.</b> n = {c.people_carried}; no inferential claim is made from these counts.</li>
          <li><b>The modern era is documented mainly through the press,</b> a different evidentiary regime from the premodern chapters and not directly comparable to them.</li>
          <li><b>Korean-language sources dominate.</b> An Indian-source corroboration round has not been carried out.</li>
          <li><b>No woman appears in the record before 1990.</b> The register records that absence; it cannot by itself explain it.</li>
          <li><b>Only {c.journeys_routed} of {c.travels} travels have a recoverable route,</b> which is why no map is published.</li>
        </ul>
      </div>
    </section>

    <section class="section" id="data" aria-labelledby="facts-h">
      <ProjectFacts
        project={p}
        duration="Data collection and classification from July 2026; dataset frozen at v3.0 on 17 August 2026; the argument and explore interfaces first published August 2026."
        resources={[
          { href: '/projects/buddhist-bridges/explore/', label: 'Explore the evidence', note: 'timeline, networks and the register' },
          { href: '/projects/buddhist-bridges/data/', label: 'Method and data', note: 'inclusion criteria, grading, figure grammar' },
          { href: '/data/people.json', label: 'people.json', note: '43 carried mediators with sources', download: true },
          { href: '/data/timeline.json', label: 'timeline.json', note: '182 dated marks, carried and excluded', download: true },
          { href: '/data/story.json', label: 'story.json', download: true },
          { href: '/data/sources.json', label: 'sources.json', note: '187 graded sources', download: true },
          { href: '/data/network.json', label: 'network.json', note: 'the two period slices', download: true },
        ]}
        licence="Dataset CC BY 4.0 · code MIT. Third-party source texts quoted in the evidence fields remain with their rights holders."
        citation="Bilal, Mohd. Five Bridges, One Silence: Documented Mediators of India–Korea Buddhist Exchange, 300–2026. Dataset v3.0, frozen 17 August 2026."
        url="https://mohdbilaldh.github.io/projects/buddhist-bridges/" />
    </section>
  </div>
</Project>
<style>
  .flush { margin-top: 0; }
  .limits, .findlist { max-width: var(--w-measure); }
  .limits li, .findlist li { margin-bottom: 12px; }
</style>
