---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Factsheet from '../components/Factsheet.astro';
import { site } from '../data/site';

const rows = [
  { term: 'Email', html: `<a href="mailto:${site.email}">${site.email}</a>` },
  { term: 'Affiliation', html: 'Graduate School of Korean Studies,<br />The Academy of Korean Studies,<br />Seongnam, Republic of Korea' },
  { term: 'Code & data', html: `<a href="${site.github}">${site.githubLabel}</a>` },
  { term: 'ORCID', html: `<a href="${site.orcid}">${site.orcidId}</a>` },
];
---
<Base title="Contact" current="contact"
  description="Contact Mohd Bilal, Korean Studies and Digital Humanities, The Academy of Korean Studies.">
  <div class="wrap contact-cols">
    <div class="page-head">
      <Eyebrow>Get in touch</Eyebrow>
      <h1>Contact</h1>
      <p class="lede prose">{site.contactLede}</p>
    </div>
    <div class="prose">
      <Factsheet rows={rows} />
      <p class="muted small note">{site.contactNote}</p>
    </div>
  </div>
</Base>
<style>
  .note { margin-top: var(--s-4); }
  @media (min-width: 900px) {
    .contact-cols { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: 56px; align-items: start; padding-bottom: 40px; }
    .contact-cols .page-head { border-bottom: 0; margin-bottom: 0; }
    .contact-cols > .prose { padding-top: 64px; max-width: none; }
  }
</style>
