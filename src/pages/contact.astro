---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" current="contact"
  description="Contact Mohd Bilal — Korean Studies and Digital Humanities, The Academy of Korean Studies.">
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">Get in Touch</p>
      <h1>Contact</h1>
      <p class="lede">
        I am always glad to hear from people working on adjacent questions — in Korean Studies,
        digital humanities, or comparative colonial history.
      </p>
    </div>

    <dl class="factsheet" style="max-width: 34rem;">
      <div>
        <dt>Email</dt>
        <dd><a href="mailto:mohdbilalkhan2017@gmail.com">mohdbilalkhan2017@gmail.com</a></dd>
      </div>
      <div>
        <dt>Affiliation</dt>
        <dd>Division of Global Korean Studies,<br />The Academy of Korean Studies,<br />Seongnam, Republic of Korea</dd>
      </div>
      <div>
        <dt>Code &amp; data</dt>
        <dd><a href="https://github.com/mohdbilalDH">github.com/mohdbilalDH</a></dd>
      </div>
    </dl>

    <p style="margin: var(--s-6) 0 var(--s-7); color: var(--muted); font-size: 0.95rem;">
      For questions about a specific project's data or method, the project pages carry
      citation and licensing details; corrections to any dataset are welcome by email.
    </p>
  </div>
</Base>
