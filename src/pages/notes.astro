---
import Base from '../layouts/Base.astro';
---

<Base
  title="Notes — Mohd Bilal"
  description="Research notes from the field: sources, methods, and working observations from projects on Hallyu, Korean print culture, and India–Korea exchange."
>
  <section class="band container">
    <h1 class="display-md rise">Notes</h1>

    <div class="empty prose rise rise-2">
      <p class="body-md line-1">
        Field notes and methods write-ups from the projects: sources found, problems
        solved, and how the corpora get built.
      </p>
      <p class="body-md line-2">Nothing here yet — the first notes will arrive as the work does.</p>
    </div>
  </section>

  <style>
    .empty {
      margin-top: var(--s-2xl);
    }

    .line-1 {
      margin: 0 0 var(--s-sm);
      color: var(--ink);
    }

    .line-2 {
      margin: 0;
      color: var(--body);
    }
  </style>
</Base>
