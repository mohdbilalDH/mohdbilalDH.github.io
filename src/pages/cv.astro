---
import Base from '../layouts/Base.astro';
import presentations from '../data/presentations.json';

const byYear = presentations.reduce((acc: Record<number, typeof presentations>, p) => {
  (acc[p.year] ||= []).push(p);
  return acc;
}, {});
const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<Base
  title="CV — Mohd Bilal"
  description="CV of Mohd Bilal: Korean Studies at the Academy of Korean Studies, digital humanities projects, skills, and languages. Downloadable PDF."
>
  <section class="band container">
    <h1 class="display-md rise">CV</h1>
    <a class="pill pill--filled dl rise rise-2" href="/files/mohd-bilal-cv.pdf" download>Download the PDF →</a>
  </section>

  <div class="container"><hr class="hr" /></div>

  <section class="band container reveal">
    <h2 class="display-sm">Education</h2>
    <ul class="cv-list">
      <li>
        <p class="body-md item-title">MA, Korean Studies</p>
        <p class="body-sm item-meta">Academy of Korean Studies, South Korea · 2024–present <span class="tag">in progress</span></p>
      </li>
      <li>
        <p class="body-md item-title">Exchange student, International College</p>
        <p class="body-sm item-meta">Seoul National University, South Korea · Fall 2025</p>
      </li>
      <li>
        <p class="body-md item-title">BA, Korean Studies</p>
        <p class="body-sm item-meta">Jawaharlal Nehru University, New Delhi, India · 2020–2023</p>
      </li>
    </ul>
  </section>

  <div class="container"><hr class="hr" /></div>

  <section class="band container reveal">
    <h2 class="display-sm">Research areas</h2>
    <p class="body-md areas">
      Hallyu and media reception · Korean cultural history · digital humanities
      methods · India–Korea exchanges
    </p>
  </section>

  <div class="container"><hr class="hr" /></div>

  <section class="band container reveal">
    <h2 class="display-sm">Projects</h2>
    <ul class="cv-list">
      <li>
        <p class="body-md item-title"><a href="/projects/hallyu-press">Hallyu in the Indian Press</a></p>
        <p class="body-sm item-meta">Indian newspaper corpus of Korean Wave coverage, 2000–2026 <span class="tag">corpus building</span></p>
      </li>
      <li>
        <p class="body-md item-title"><a href="/projects/buddhist-bridges">Buddhist Bridges</a></p>
        <p class="body-sm item-meta">Network dataset of India–Korea Buddhist mediators <span class="tag">in analysis</span></p>
      </li>
      <li>
        <p class="body-md item-title"><a href="/projects/janghan">Janghan (장한, 1927)</a></p>
        <p class="body-sm item-meta">Machine-readable corpus of the kisaeng magazine <span class="tag">corpus building</span></p>
      </li>
    </ul>
  </section>

  <div class="container"><hr class="hr" /></div>

  <section class="band container reveal">
    <h2 class="display-sm">Publications</h2>
    <ul class="cv-list">
      <li>
        <p class="body-md item-title">
          Bilal, Mohd, and Santosh Kumar Ranjan. “Hybridizing Culture and Linguistics: A Case
          Study of K-Dramas’ Impact in India.”
        </p>
        <p class="body-sm item-meta"><em>The Myanmar Journal</em> 11, no. 1 (2024): 165–188.</p>
      </li>
      <li>
        <p class="body-md item-title">
          Bilal, Mohd. “The Role of Remakes and Adaptations in Activating Indian Agency.”
        </p>
        <p class="body-sm item-meta">
          <em>Asian Communication Research</em>, special issue “Circuits of K-content:
          Co-productions, Collaborations, and Connections” <span class="tag">under review</span>
        </p>
      </li>
    </ul>
  </section>

  <div class="container"><hr class="hr" /></div>

  <section class="band container reveal">
    <h2 class="display-sm">Conference presentations</h2>
    {
      years.map((year) => (
        <div class="year-block">
          <p class="caption-mono-sm year-label">{year}</p>
          <ul class="cv-list">
            {byYear[year].map((p) => (
              <li>
                <p class="body-md item-title">“{p.title}”</p>
                <p class="body-sm item-meta">
                  {p.venue} · {p.place} · {p.when}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <div class="container"><hr class="hr" /></div>

  <section class="band container reveal">
    <h2 class="display-sm">Experience</h2>
    <ul class="cv-list">
      <li>
        <p class="body-md item-title">Graduate Teaching Assistant</p>
        <p class="body-sm item-meta">Division of Global Korean Studies, Academy of Korean Studies · March 2025–present</p>
      </li>
      <li>
        <p class="body-md item-title">University Research Assistant, project AKSR2024-C19</p>
        <p class="body-sm item-meta">Academy of Korean Studies · September–December 2024</p>
      </li>
      <li>
        <p class="body-md item-title">K-Campus Ambassador</p>
        <p class="body-sm item-meta">JoongAng Ilbo, Seoul · March–August 2025</p>
      </li>
    </ul>
  </section>

  <div class="container"><hr class="hr" /></div>

  <section class="band container reveal">
    <h2 class="display-sm">Awards &amp; fellowships</h2>
    <ul class="cv-list">
      <li>
        <p class="body-md item-title">Academy of Korean Studies Graduate Scholarship for Master's Degree</p>
        <p class="body-sm item-meta">2024–present · full tuition, monthly living stipend, research support, and Korean language training</p>
      </li>
      <li>
        <p class="body-md item-title">Korea Foundation (KF) Scholarship for Graduate Studies</p>
        <p class="body-sm item-meta">2023–2024 · awarded for research on Korea's kisaeng and India's devadasi</p>
      </li>
    </ul>
  </section>

  <div class="container"><hr class="hr" /></div>

  <section class="band container reveal">
    <div class="two-col">
      <div>
        <h2 class="display-sm">Skills</h2>
        <p class="body-md areas">
          Python · SQLite/DuckDB · Korean NLP (Kiwi) · network analysis · corpus
          construction · Astro/web publishing
        </p>
      </div>
      <div>
        <h2 class="display-sm">Languages</h2>
        <p class="body-md areas">
          English (fluent) · Hindi/Urdu (native) · Korean (working research proficiency) ·
          Hanja-mixed/classical reading
        </p>
      </div>
    </div>
  </section>

  <style>
    .dl {
      margin-top: var(--s-xl);
    }

    .cv-list {
      list-style: none;
      margin: var(--s-xl) 0 0;
      padding: 0;
      max-width: var(--measure);
    }

    .cv-list li {
      padding: var(--s-lg) 0;
      border-bottom: 1px solid var(--hairline);
    }

    .cv-list li:last-child {
      border-bottom: 0;
    }

    .item-title {
      margin: 0;
      color: var(--ink);
    }

    .item-title a {
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: var(--pill-border);
    }

    .item-title a:hover {
      text-decoration-color: var(--ink);
    }

    .item-meta {
      margin: var(--s-xs) 0 0;
      color: var(--body);
    }

    .tag {
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--body);
      border: 1px solid var(--hairline);
      border-radius: var(--radius-pill);
      padding: 1px 8px;
      margin-left: var(--s-sm);
      white-space: nowrap;
    }

    .areas {
      margin: var(--s-lg) 0 0;
      max-width: var(--measure);
    }

    .year-block {
      margin-top: var(--s-xl);
    }

    .year-label {
      margin: 0;
    }

    .year-block .cv-list {
      margin-top: var(--s-sm);
    }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--s-3xl);
    }

    @media (max-width: 767px) {
      .two-col {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
