---
import Base from '../layouts/Base.astro';
---

<Base
  title="Publications & Talks — Mohd Bilal"
  description="Publications and conference papers by Mohd Bilal will be listed here as they appear."
>
  <section class="band container">
    <h1 class="display-md rise">Publications &amp; Talks</h1>

    <div class="empty prose rise rise-2">
      <p class="body-md line-1">Publications and conference papers will be listed here as they appear.</p>
      <p class="body-md line-2">Until then, current research lives on the Projects pages.</p>
      <a class="pill" href="/projects">Projects →</a>
    </div>
  </section>

  <style>
    .empty {
      margin-top: var(--s-2xl);
    }

    .line-1 {
      margin: 0 0 var(--s-sm);
      color: var(--ink);
    }

    .line-2 {
      margin: 0 0 var(--s-xl);
      color: var(--body);
    }
  </style>
</Base>
