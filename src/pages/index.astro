---
import Base from '../layouts/Base.astro';
import presentations from '../data/presentations.json';
const recent = presentations.slice(0, 3);
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mohd Bilal',
  email: 'mailto:mohdbilalkhan2017@gmail.com',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'The Academy of Korean Studies' },
  url: 'https://mohdbilaldh.github.io/',
  sameAs: ['https://github.com/mohdbilalDH', 'https://orcid.org/0009-0007-8367-4690'],
});
---
<Base current="">
  <script slot="head" type="application/ld+json" set:html={jsonld}></script>

  <div class="wrap">
    <div class="page-head" style="margin-bottom: var(--s-5);">
      <p class="eyebrow">Korean Studies · Digital Humanities</p>
      <h1>Mohd Bilal</h1>
      <p class="lede">
        M.A. student in Korean Studies at The Academy of Korean Studies, working on modern
        Korean history and its cultural afterlives — between the colonial period and the
        contemporary moment, and between archival and computational methods.
      </p>
    </div>

    <p>
      My research centres on gender and cultural history in modern Korea, with a particular
      interest in how women appear — and are made to appear — in the print culture of colonial
      Korea. Much of my current work concerns <em>kisaeng</em>, and how the periodical press of
      the 1920s and 1930s framed them as both objects of nostalgia and figures of modern
      anxiety. The sources are uneven, censored, and often hostile to the people they describe,
      which makes reading them a methodological problem as much as a historical one.
    </p>
    <p>
      I also work on the Korean Wave — particularly how Korean popular culture has been received
      and reframed in Indian media — and on comparisons between Korea and South Asia: colonial
      modernity, gendered performance traditions, and the uneven ways cultural forms travel
      between the two regions.
    </p>
    <p>
      The computational side of this work runs through corpus construction from historical
      newspapers, text analysis of Hangul–Hanja mixed sources, historical GIS, and network
      analysis. Colonial-era sources are fragmentary and full of uncertainty about dates, names,
      and authorship; most computational work smooths that uncertainty away. I would rather
      represent it — building projects that show the limits of what the archive can support,
      alongside what it reveals.
    </p>

    <h2 style="margin-top: var(--s-6);">Research</h2>
    <div class="project-grid" style="margin-top: var(--s-4);">
      <a class="project-card" href="/projects/janghan/">
        <span class="visual" aria-hidden="true">
          <svg viewBox="0 0 100 100">
            <rect x="0" y="0" width="100" height="100" fill="var(--card)" />
            <rect x="22" y="12" width="52" height="72" rx="1" fill="var(--paper)" stroke="var(--rule)" stroke-width="1.2" />
            <rect x="22" y="12" width="52" height="72" rx="1" fill="none" stroke="var(--b6)" stroke-width="0.8" opacity="0.5" />
            <circle cx="38" cy="25" r="6.5" fill="var(--b6)" />
            <circle cx="55" cy="25" r="6.5" fill="var(--b6)" />
            <path d="M37 44 q11 -8 22 0 v20 h-22 z" fill="none" stroke="var(--b4)" stroke-width="1.4" />
            <line x1="42.5" y1="42.5" x2="42.5" y2="64" stroke="var(--b4)" stroke-width="1" />
            <line x1="48" y1="41" x2="48" y2="64" stroke="var(--b4)" stroke-width="1" />
            <line x1="53.5" y1="42.5" x2="53.5" y2="64" stroke="var(--b4)" stroke-width="1" />
            <line x1="30" y1="72" x2="66" y2="72" stroke="var(--rule)" stroke-width="1.4" />
            <line x1="30" y1="77" x2="58" y2="77" stroke="var(--rule)" stroke-width="1.4" />
          </svg>
        </span>
        <h3>長恨 (1927)</h3>
        <p class="desc">The only magazine edited and largely written by Korean gisaeng — a digital scholarly edition of both issues, reconstructed from four witnesses that disagree about its contents.</p>
        <span class="meta"><span class="status-badge complete">Issue 1 corpus frozen</span></span>
      </a>
      <a class="project-card" href="/projects/buddhist-bridges/">
        <span class="visual" aria-hidden="true">
          <svg viewBox="0 0 100 100">
            <rect x="0" y="0" width="100" height="100" fill="var(--card)" />
            <rect x="10" y="16" width="14" height="6" rx="1.2" fill="var(--b1)" />
            <rect x="26" y="30" width="11" height="6" rx="1.2" fill="var(--b2)" />
            <line x1="39" y1="47" x2="61" y2="47" stroke="var(--void)" stroke-width="2.5" stroke-dasharray="2 4" />
            <rect x="63" y="58" width="8" height="6" rx="1.2" fill="var(--b4)" />
            <rect x="73" y="70" width="8" height="6" rx="1.2" fill="var(--b5)" />
            <rect x="82" y="82" width="10" height="6" rx="1.2" fill="var(--b6)" />
          </svg>
        </span>
        <h3>Buddhist Bridges</h3>
        <p class="desc">Sixteen centuries of documented India–Korea Buddhist exchange: five short-lived bridges, one five-hundred-year silence.</p>
        <span class="meta"><span class="status-badge complete">Dataset frozen · V3.0</span></span>
      </a>
      <a class="project-card" href="/projects/hallyu-indian-press/">
        <span class="visual" aria-hidden="true">
          <svg viewBox="0 0 100 100">
            <rect x="0" y="0" width="100" height="100" fill="var(--card)" />
            <rect x="16" y="79" width="18" height="2" fill="var(--b6)" opacity="0.55" />
            <rect x="42" y="74" width="18" height="7" fill="var(--b6)" opacity="0.75" />
            <rect x="68" y="20" width="18" height="61" fill="var(--b6)" />
            <line x1="10" y1="81.5" x2="92" y2="81.5" stroke="var(--rule)" stroke-width="1" />
          </svg>
        </span>
        <h3>Framing Hallyu in the Indian Press</h3>
        <p class="desc">How Indian English-language newspapers represented Hallyu, 2000–2026 — a reproducible corpus project.</p>
        <span class="meta"><span class="status-badge in-progress">Pilot · in progress</span></span>
      </a>
    </div>

    <h2>Recent</h2>
    <ul class="pub-list">
      <li>
        <span class="pub-title">“Hybridizing Culture and Linguistics: A Case Study of K-Dramas’ Impact in India.”</span>
        <span class="pub-venue"><em>The Myanmar Journal</em> 11, no. 1 (2024): 165–188. With Santosh Kumar Ranjan.</span>
        <p class="pub-meta">Journal article</p>
      </li>
      {recent.map((p) => (
        <li>
          <span class="pub-title">“{p.title}.”</span>
          <span class="pub-venue">{p.venue}{p.place ? `, ${p.place}` : ''}.</span>
          <p class="pub-meta">Conference presentation · {p.when}</p>
        </li>
      ))}
    </ul>
    <p class="no-print" style="margin-bottom: var(--s-7);">
      <a href="/publications/">All publications and presentations →</a>
    </p>
  </div>
</Base>
