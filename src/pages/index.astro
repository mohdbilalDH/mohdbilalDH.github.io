---
import Base from '../layouts/Base.astro';
---

<Base
  title="Mohd Bilal — Korean Studies & Digital Humanities"
  description="Mohd Bilal is a Korean Studies researcher at the Academy of Korean Studies, working on Hallyu in India, Korean print culture, and India–Korea exchange with computational methods."
>
  <div class="hero-band">
    <section class="hero container">
      <p class="eyebrow rise">Korean Studies · Digital Humanities</p>
    <h1 class="display-xl rise rise-2">Mohd Bilal</h1>
    <div class="hero-body prose">
      <p class="body-lg rise rise-3">
        Korean Studies researcher using computational methods to study Hallyu, Korean
        print culture, and the long history of exchange between India and Korea.
      </p>
      <p class="body-md rise rise-3">
        I'm a Master's student at the Academy of Korean Studies. My current work builds
        corpora and networks: Indian newspaper coverage of the Korean Wave, the people
        who carried Buddhism between India and Korea, and a magazine written by kisaeng
        in 1927.
      </p>
    </div>
    <div class="hero-ctas rise rise-4">
      <a class="pill pill--filled" href="/projects">View my projects →</a>
      <a class="pill" href="/cv">Read my CV →</a>
    </div>
    </section>
  </div>

  <style>
    .hero-band {
      background: var(--sky-gradient);
    }

    .hero {
      padding-block: clamp(56px, 12vh, 112px) 80px;
    }

    .hero .eyebrow {
      color: var(--ink);
    }

    .hero h1 {
      margin-top: var(--s-lg);
      max-width: 14ch;
    }

    .hero-body {
      margin-top: var(--s-2xl);
    }

    .hero-body .body-lg {
      color: var(--ink);
    }

    .hero-body .body-md {
      color: var(--body);
    }

    .hero-ctas {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-md);
      margin-top: var(--s-2xl);
    }
  </style>
</Base>
