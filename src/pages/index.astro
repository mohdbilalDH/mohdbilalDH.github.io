---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ProjectTable from '../components/ProjectTable.astro';
import PubList from '../components/PubList.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { articles, venueLine } from '../data/publications';
import presentations from '../data/presentations.json';

const recent = [
  ...articles
    .filter((a) => a.status !== 'under-review')
    .sort((a, b) => b.year - a.year)
    .map((a) => ({ title: a.title, venue: venueLine(a), meta: a.status === 'forthcoming' ? 'Journal article · forthcoming' : 'Journal article' })),
  ...presentations.slice(0, 2).map((p) => ({ title: p.title, venue: `${p.venue}${p.place ? `, ${p.place}` : ''}.`, meta: `Conference presentation · ${p.when}` })),
];
---
<Base current="">
  <div class="wrap">
    <section class="hero">
      <Eyebrow>{site.role}</Eyebrow>
      <h1 class="display">{site.name}</h1>
      <p class="mono muted role">{site.affiliation}</p>
      <div class="hero-grid">
        <div class="hero-main">
          <p class="lede">{site.lede}</p>
          <div class="btn-row no-print">
            <Button href="/projects/" variant="primary">View projects</Button>
            <Button href="/files/mohd-bilal-cv.pdf" download>Download CV (PDF)</Button>
          </div>
        </div>
        <div class="hero-side">
          <p class="label side-label">Projects</p>
          <ProjectTable projects={projects} />
        </div>
      </div>
    </section>

    <section class="prose bio">
      {site.bio.map((p) => <p set:html={p} />)}
    </section>

    <section class="section">
      <h2>Recent</h2>
      <PubList items={recent} />
      <p class="no-print"><a href="/publications/">All publications and presentations →</a></p>
    </section>
  </div>
</Base>
<style>
  .hero { padding: var(--s-6) 0 var(--s-5); border-bottom: var(--rule-w) solid var(--rule); }
  .role { margin: var(--s-2) 0 var(--s-5); }
  .hero-grid { display: grid; gap: var(--s-5); }
  .hero-main .lede { max-width: 36rem; }
  .side-label { margin: 0 0 var(--s-1); }
  @media (min-width: 1200px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: start; gap: var(--s-7); }
  }
  .bio { padding-top: var(--s-5); }
  @media (max-width: 639px) { .hero { padding-top: var(--s-5); } .role { margin-bottom: var(--s-4); } }
</style>
