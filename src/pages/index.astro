---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CardRow from '../components/CardRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Tile from '../components/Tile.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { byStatus } from '../data/publications';
import presentations from '../data/presentations.json';

const forthcoming = byStatus('forthcoming')[0];
const latestTalk = presentations[0];
const news = [
  { href: '/publications/', date: 'Forthcoming · 2026', title: forthcoming.title, meta: `${forthcoming.venue} ${forthcoming.volume}, no. ${forthcoming.issue}` },
  { href: '/publications/', date: latestTalk.when, title: latestTalk.title, meta: `${latestTalk.venue}${latestTalk.place ? `, ${latestTalk.place}` : ''}` },
  { href: '/projects/buddhist-bridges/', date: 'Dataset · 17 August 2026', title: 'Buddhist Bridges dataset V3.0 frozen and checksummed', meta: '43 documented mediators, 187 graded sources, CC-BY-4.0' },
];
const talks = presentations.slice(0, 6);
---
<Base current="home">
  <section class="band hero-band">
    <div class="wrap hero">
      <div class="hero-text">
        <h1 class="page-title">{site.name}</h1>
        <p class="intro">{site.lede}</p>
        <Button href="/about/" variant="primary">More details »</Button>
      </div>
      <figure class="hero-fig">
        <img src="/janghan/assets/jh01-cover.png" width="900" height="1470" fetchpriority="high"
             alt="Cover of 長恨 issue 1, January 1927: a woman seated inside a birdcage, with the title in two circular seals above." />
        <figcaption class="caption"><span lang="ko">長恨 창간호</span>, 10 January 1927 — the magazine the kisaeng made. Yonsei University Library copy, from the 長恨 digital edition.</figcaption>
      </figure>
    </div>
  </section>

  <section class="band band--white">
    <div class="wrap">
      <SectionHeading>What's New</SectionHeading>
      <div class="tile-grid">
        {news.map((n) => <Tile href={n.href} date={n.date} title={n.title} meta={n.meta} />)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <SectionHeading>Explore my Projects</SectionHeading>
      <p class="intro band-intro">Digital Humanities projects built on documented sources, graded evidence, and reproducible pipelines.</p>
      <CardRow cols={3}>
        {projects.map((p) => <ProjectCard project={p} />)}
      </CardRow>
      <div class="btn-row"><Button href="/projects/" variant="primary">View all projects »</Button></div>
    </div>
  </section>

  <section class="band band--white">
    <div class="wrap">
      <SectionHeading>Talks and Presentations</SectionHeading>
      <div class="tile-grid">
        {talks.map((t) => <Tile date={t.when} title={t.title} meta={`${t.venue}${t.place ? `, ${t.place}` : ''}`} />)}
      </div>
      <div class="btn-row"><Button href="/publications/" variant="primary">View all »</Button></div>
    </div>
  </section>
</Base>
<style>
  .hero-band { padding: 100px 0 70px; }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 440px); gap: 48px; align-items: center; }
  .hero-text .page-title { line-height: 1.2; margin-bottom: 20px; }
  .hero-text .intro { margin-bottom: 32px; max-width: 54ch; }
  .hero-fig { margin: 0; justify-self: stretch; }
  .hero-fig img { display: block; width: auto; max-width: 100%; max-height: 430px; height: auto; margin: 0 auto; }
  .hero-fig { background: var(--white); border: 1px solid var(--hairline); border-radius: var(--r-card); padding: 24px; }
  .hero-fig figcaption { margin-top: 12px; }
  .band-intro { margin-bottom: 28px; }
  @media (max-width: 900px) {
    .hero-band { padding: 60px 0 50px; }
    .hero { grid-template-columns: 1fr; gap: 36px; }
    .hero-fig { justify-self: start; max-width: 360px; }
  }
</style>
