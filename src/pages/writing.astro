---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import PubList from '../components/PubList.astro';
import { byStatus, venueLine } from '../data/publications';
import presentations from '../data/presentations.json';

const strands = [
  { key: 'gender', label: 'Gender and colonial print culture' },
  { key: 'hallyu', label: 'Hallyu and media reception' },
  { key: 'india-korea', label: 'India–Korea exchange' },
  { key: 'other', label: 'Other papers' },
];
const published = byStatus('published')[0];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: published.title,
  author: [
    { '@type': 'Person', name: 'Mohd Bilal', sameAs: 'https://orcid.org/0009-0007-8367-4690' },
    { '@type': 'Person', name: 'Santosh Kumar Ranjan' },
  ],
  datePublished: String(published.year),
  isPartOf: {
    '@type': 'PublicationIssue',
    issueNumber: published.issue,
    isPartOf: { '@type': 'PublicationVolume', volumeNumber: published.volume, isPartOf: { '@type': 'Periodical', name: published.venue } },
  },
  pagination: published.pages?.replace('–', '-'),
};
---
<Base title="Writing" current="writing"
  description="Publications and conference presentations by Mohd Bilal, grouped by research strand: gender and colonial print culture, Hallyu and media reception, and India–Korea exchange.">
  <Fragment slot="head">
    <meta name="citation_title" content={published.title.replace('’', "'")} />
    <meta name="citation_author" content="Bilal, Mohd" />
    <meta name="citation_author" content="Ranjan, Santosh Kumar" />
    <meta name="citation_publication_date" content={String(published.year)} />
    <meta name="citation_journal_title" content={published.venue} />
    <meta name="citation_volume" content={published.volume} />
    <meta name="citation_issue" content={published.issue} />
    <meta name="citation_firstpage" content="165" />
    <meta name="citation_lastpage" content="188" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </Fragment>

  <PageTitle title="Writing"
    lede="Articles and conference papers. Talks are grouped by research strand rather than by year, because the strand is the informative ordering: the dates are on each entry." />

  <section class="band band--flush">
    <div class="wrap">
      <section class="section first">
        <h2>Journal articles</h2>
        <PubList items={byStatus('published').map((a) => ({ title: a.title, venue: venueLine(a) }))} />
        <p class="label sub">Forthcoming</p>
        <PubList items={byStatus('forthcoming').map((a) => ({ title: a.title, venue: venueLine(a), meta: a.note }))} />
        <p class="label sub">Under review</p>
        <PubList items={byStatus('under-review').map((a) => ({ title: a.title, venue: `<em>${a.venue}</em>, ${a.note}.` }))} />
      </section>

      <section class="section">
        <h2>Conference presentations</h2>
        {strands.map((s) => {
          const items = presentations.filter((p) => p.strand === s.key).sort((a, b) => b.year - a.year);
          return items.length === 0 ? null : (
            <>
              <p class="label sub">{s.label}</p>
              <PubList items={items.map((p) => ({ title: p.title, venue: `${p.venue}${p.place ? `, ${p.place}` : ''}, ${p.when}.` }))} />
            </>
          );
        })}
      </section>

      <p class="muted small">A complete academic record, including training and awards, is on the <a href="/cv/">CV</a>.</p>
    </div>
  </section>
</Base>
<style>
  .first { margin-top: 0; }
  .sub { margin: var(--s-4) 0 var(--s-1); }
</style>
