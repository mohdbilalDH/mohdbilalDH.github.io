---
import Base from '../layouts/Base.astro';
import CohortStrip from '../components/CohortStrip.astro';
import Chronology from '../components/Chronology.astro';
import Corridor from '../components/Corridor.astro';
import DirectionChart from '../components/DirectionChart.astro';
import PersonCard from '../components/PersonCard.astro';
import HallyuGrowthChart from '../components/HallyuGrowthChart.astro';
---
<Base title="Visualizations" current="visualizations"
  description="Research visualizations by Mohd Bilal: the Buddhist Bridges chronology, route corridors and direction charts of India–Korea exchange, and press-corpus analysis of Hallyu in India.">
  <div class="wrap breakout-figs">
    <div class="page-head">
      <p class="eyebrow">Research Instruments</p>
      <h1>Visualizations</h1>
      <p class="lede">
        Every figure here is an argument from a documented dataset — built to show what the
        sources can support, including their gaps and uncertainty, not to decorate. Each
        carries a stated finding, a caption, and its data as a table.
      </p>
    </div>

    <section style="border-top: 1px solid var(--rule); margin-top: var(--s-5); padding-top: var(--s-2);">
      <h2>Buddhist Bridges — India–Korea exchange, 300–2026</h2>
      <p>
        From the <a href="/projects/buddhist-bridges/">Buddhist Bridges</a> project: 43
        documented mediators in a frozen, source-graded dataset. Solid marks are explicitly
        dated records; dashed marks are floruit-derived; the dotted line is the Joseon void —
        an absence annotated in place, not smoothed away.
      </p>
      <CohortStrip />
      <Chronology />
      <DirectionChart />
      <Corridor />
      <p>
        The <a href="/projects/buddhist-bridges/explore/">explore view</a> lets you open every
        person record, with each claim cited to a record ID and source key.
      </p>
    </section>

    <section style="border-top: 1px solid var(--rule); margin-top: var(--s-7); padding-top: var(--s-2);">
      <h2>Hallyu in the Indian press</h2>
      <p>
        From the <a href="/projects/hallyu-indian-press/">Framing Hallyu</a> pilot: licensed
        full-text counts across three national dailies, corroborated by an independent
        open-web harvest of The Hindu's archives.
      </p>
      <HallyuGrowthChart />
    </section>

    <p style="margin: var(--s-7) 0; color: var(--muted); font-size: 0.9rem;">
      Charts are hand-built SVG on a shared uncertainty grammar — no charting framework, no
      decoration. Colors are machine-validated for color-vision safety in light and dark modes.
    </p>
  </div>
  <PersonCard />
</Base>
