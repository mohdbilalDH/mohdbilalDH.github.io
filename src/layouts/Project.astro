---
// Project pages carry the full site chrome plus optional Google Scholar citation
// metadata and a Dataset JSON-LD block.
import Base from './Base.astro';
interface Props { title: string; description?: string; citationTitle?: string; jsonld?: object }
const { title, description = 'A Digital Humanities research project by Mohd Bilal.', citationTitle, jsonld } = Astro.props;
---
<Base title={title} description={description} current="projects">
  <Fragment slot="head">
    {citationTitle && (
      <>
        <meta name="citation_title" content={citationTitle} />
        <meta name="citation_author" content="Bilal, Mohd" />
        <meta name="citation_publication_date" content="2026" />
      </>
    )}
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </Fragment>
  <slot />
</Base>
<style is:global>
  /* Project pages are long and are browsed rather than read straight through, so each major
     section opens on a rule. Scoped to this layout: other pages keep their plain spacing. */
  main .section { margin-top: 64px; padding-top: 28px; border-top: 1px solid var(--hairline); }
  main .section.flush { margin-top: 32px; padding-top: 0; border-top: 0; }
  main .section > h2 { margin-top: 0; }
  main .section h3 { margin-top: 44px; }
  main .section h3:first-of-type { margin-top: 24px; }
  /* "See the evidence" links tie a finding back to the figure that carries it. */
  main .backto { display: inline-flex; align-items: center; gap: 0.35em; min-height: 44px;
    margin-top: 2px; font: 500 13.5px/1.4 var(--f-ui); }
  @media (max-width: 640px) { main .section { margin-top: 44px; padding-top: 22px; } }
</style>
