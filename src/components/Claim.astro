---
// Slot 1 of the project contract: kind, state, title, the question, the finding,
// and a metadata line of counts. Nothing else belongs above the first figure.
import type { Project } from '../data/projects';
import { kindLabel } from '../data/projects';
interface Props { project: Project; meta?: string }
const { project: p, meta } = Astro.props;
---
<div class="claim">
  <p class="claim-chips">
    <span class="chip chip--kind">{kindLabel[p.kind]}</span>
    <span class={`chip chip--state chip--${p.state}`}>{p.stateLabel}</span>
    <span class="chip chip--dates">{p.dates}</span>
  </p>
  <h1>{p.title}</h1>
  <p class="claim-q">{p.question}</p>
  <p class="claim-f">{p.finding}</p>
  {meta && <p class="claim-meta mono">{meta}</p>}
  <details class="ko-summary">
    <summary><span lang="ko">한국어 요약</span></summary>
    <p lang="ko" set:html={p.summaryKo} />
  </details>
</div>
<style>
  .claim { padding: 100px 0 32px; border-bottom: 1px solid var(--hairline); margin-bottom: 40px; }
  .claim h1 { font: 600 var(--t-page)/1.18 var(--f-title); color: var(--title); margin: 0 0 20px; max-width: 20ch; }
  .claim-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 20px; }
  .chip { font: 500 11.5px/1.4 var(--f-ui); letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 10px; border: 1px solid var(--hairline); color: var(--muted); background: var(--white); }
  .chip--kind { border-color: var(--navy); color: var(--navy); }
  .chip--frozen, .chip--released { color: var(--grade-high); border-color: var(--grade-high); }
  .chip--in-progress { color: var(--grade-medium); border-color: var(--grade-medium); }
  .claim-q { font: 400 21px/1.5 var(--f-ui); color: var(--heading); max-width: 46ch; margin: 0 0 18px; }
  .claim-f { font: 400 var(--t-intro)/1.75 var(--f-ui); color: var(--text); max-width: 62ch; margin: 0 0 20px; }
  .claim-meta { color: var(--muted); margin: 0; }
  .ko-summary { margin-top: 24px; max-width: var(--w-measure); border-top: 1px solid var(--hairline); padding-top: 12px; }
  .ko-summary summary { cursor: pointer; font: 500 13px/1.5 var(--f-ui); color: var(--muted); letter-spacing: 0.04em; }
  .ko-summary p { font: 400 14px/1.9 var(--f-body); color: var(--text); margin: 12px 0 0; max-width: 62ch; }
  @media (max-width: 640px) { .claim { padding: 60px 0 24px; margin-bottom: 28px; } .claim-q { font-size: 18px; } }
</style>
