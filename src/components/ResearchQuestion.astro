---
// The research question, stated plainly and early. A project page that makes a reader infer
// the question from the prose is an essay; a project states it before the evidence.
interface Props { status?: string }
const { status } = Astro.props;
---
<section class="rq" id="question" aria-labelledby="rq-h">
  <p class="rq-kicker" id="rq-h">The research question</p>
  <div class="rq-cols">
    <blockquote class="rq-body"><slot /></blockquote>
    <div class="rq-aside">
      {Astro.slots.has('prior') && <div class="rq-prior"><slot name="prior" /></div>}
      {status && <p class="rq-status">{status}</p>}
    </div>
  </div>
</section>
<style>
  .rq { margin: 0 0 48px; padding: 28px 0 0; border-top: 3px solid var(--navy); max-width: var(--w-measure); }
  .rq-kicker { font: 500 12px/1.4 var(--f-ui); letter-spacing: 0.1em; text-transform: uppercase; color: var(--navy); margin: 0 0 14px; }
  .rq-cols { display: grid; gap: 24px 48px; }
  @media (min-width: 900px) { .rq-cols { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); align-items: start; } }
  .rq-body { margin: 0; padding: 0; font: 400 clamp(20px, 2.3vw, 27px)/1.42 var(--f-title); color: var(--heading); text-wrap: pretty; }
  .rq-body :global(p) { margin: 0 0 12px; font: inherit; }
  .rq-body :global(p:last-child) { margin-bottom: 0; }
  .rq-aside { display: flex; flex-direction: column; gap: 18px; }
  .rq-prior :global(p) { font: 400 16px/1.7 var(--f-ui); color: var(--text); margin: 0 0 10px; max-width: 54ch; }
  .rq-prior :global(p:last-child) { margin-bottom: 0; }
  .rq-status { font: 400 13.5px/1.7 var(--f-ui); color: var(--muted); margin: 0; max-width: 54ch; border-left: 2px solid var(--yellow); padding-left: 14px; }
  @media (max-width: 640px) { .rq { margin-bottom: 36px; } .rq-body { max-width: none; } }
</style>
