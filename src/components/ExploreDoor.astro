---
// Slot 3 of the contract: one door onward, never a grid of nine.
interface Props { href: string; label: string; blurb: string }
const { href, label, blurb } = Astro.props;
---
<a class="door" href={href}>
  <span class="door-label">{label} →</span>
  <span class="door-blurb">{blurb}</span>
</a>
<style>
  .door { display: block; max-width: var(--w-measure); border: 1px solid var(--hairline); border-left: 3px solid var(--navy); background: var(--white); padding: 24px 28px; text-decoration: none; color: inherit; transition: border-color var(--ease), transform var(--ease); }
  .door:hover { border-left-color: var(--yellow); transform: translateY(-1px); text-decoration: none; color: inherit; }
  .door-label { display: block; font: 700 22px/1.3 var(--f-title); color: var(--navy); margin-bottom: 8px; }
  .door-blurb { display: block; font: 400 14px/1.7 var(--f-ui); color: var(--text); max-width: 62ch; }
</style>
