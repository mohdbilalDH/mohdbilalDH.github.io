---
// Project identity, on the pattern every strong DH project directory uses: a title, a subtitle
// that names the genre of the resource and its extent, a scale line in the units of the corpus,
// and the status, version and dates that tell a reader how current and how finished it is.
import type { Project } from '../data/projects';
import { kindLabel } from '../data/projects';
import { buildDate } from '../data/build';
interface Props { project: Project; scale: { n: string; unit: string }[] }
const { project: p, scale } = Astro.props;
---
<header class="phead">
  <p class="phead-kind">{kindLabel[p.kind]} · {p.dates}</p>
  <h1>{p.title}</h1>
  <p class="phead-sub">{p.subtitle}</p>

  <dl class="scale">
    {scale.map((s) => (
      <div class="scale-cell">
        <dt class="scale-n mono">{s.n}</dt>
        <dd class="scale-u">{s.unit}</dd>
      </div>
    ))}
  </dl>

  <p class="phead-status">
    <span class={`dot dot--${p.state}`} aria-hidden="true"></span>
    <b>{p.stateLabel}</b>
    <span class="phead-meta"><span class="mono">{p.version}</span></span>
    <span class="phead-meta">page built {buildDate}</span>
  </p>

  <details class="ko-summary">
    <summary><span lang="ko">한국어 요약</span></summary>
    <p lang="ko">{p.summaryKo}</p>
  </details>
</header>
<style>
  .phead { padding: 100px 0 32px; border-bottom: 1px solid var(--hairline); margin-bottom: 40px; }
  .phead-kind { font: 500 12px/1.4 var(--f-ui); letter-spacing: 0.1em; text-transform: uppercase; color: var(--navy); margin: 0 0 14px; }
  .phead h1 { font: 600 var(--t-page)/1.18 var(--f-title); color: var(--title); margin: 0 0 14px; max-width: 20ch; }
  .phead-sub { font: 400 21px/1.5 var(--f-ui); color: var(--heading); max-width: 52ch; margin: 0 0 30px; }

  /* The scale line: the corpus counted in its own units, before any prose. */
  .scale { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 0; margin: 0 0 26px;
    max-width: var(--w-measure); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .scale-cell { padding: 14px 20px 14px 0; border-right: 1px solid var(--hairline); }
  .scale-cell:last-child { border-right: 0; }
  .scale-n { display: block; font: 500 24px/1.15 var(--f-mono); color: var(--navy); font-variant-numeric: tabular-nums; margin: 0; }
  .scale-u { display: block; font: 400 12.5px/1.4 var(--f-ui); color: var(--muted); margin: 4px 0 0; max-width: 16ch; }

  .phead-status { max-width: var(--w-measure); display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font: 400 13px/1.6 var(--f-ui); color: var(--muted); margin: 0; }
  .phead-status b { color: var(--heading); font-weight: 600; }
  .phead-meta { display: inline-flex; align-items: center; }
  .phead-meta::before { content: "·"; color: var(--hairline); margin: 0 10px 0 2px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--grade-medium); flex: none; }
  .dot--frozen, .dot--released { border-color: var(--grade-high); background: var(--grade-high); }

  .ko-summary { margin-top: 24px; max-width: var(--w-measure); border-top: 1px solid var(--hairline); padding-top: 12px; }
  .ko-summary summary { cursor: pointer; font: 500 13px/1.5 var(--f-ui); color: var(--muted); letter-spacing: 0.04em; min-height: 32px; display: flex; align-items: center; }
  .ko-summary p { font: 400 14px/1.95 var(--f-body); color: var(--text); margin: 10px 0 0; max-width: 62ch; }

  @media (max-width: 768px) {
    .phead { padding: 60px 0 24px; margin-bottom: 28px; }
    .phead-sub { font-size: 18px; }
    .scale-cell { padding: 12px 14px 12px 0; }
    .scale-n { font-size: 20px; }
  }
  /* Wrapped rows leave the separator hanging at the edge, so narrow screens rule underneath. */
  @media (max-width: 560px) {
    .scale { border-bottom: 0; }
    .scale-cell { border-right: 0; border-bottom: 1px solid var(--hairline); padding-right: 12px; }
  }
</style>
