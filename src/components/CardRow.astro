---
interface Props { cols?: 1 | 2 | 3 }
const { cols = 3 } = Astro.props;
---
<div class={`card-row cols-${cols}`}><slot /></div>
<style>
  .card-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 0 0 20px; }
  .cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cols-1 { grid-template-columns: 1fr; }
  .cols-1 :global(.project-card) { min-height: 420px; }
  @media (max-width: 640px) { .card-row, .cols-2 { grid-template-columns: 1fr; } .cols-1 :global(.project-card) { min-height: var(--card-h); } }
</style>
<script>
  // Reference behaviour: cards fade up as they enter the viewport. Elements already in view
  // resolve immediately; without IntersectionObserver everything shows at once.
  const els = document.querySelectorAll<HTMLElement>('.fade-up');
  if (!('IntersectionObserver' in window)) {
    document.documentElement.classList.add('no-io');
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.15 });
    els.forEach((el) => io.observe(el));
  }
</script>
