---
interface Props { state: 'frozen' | 'in-progress'; label: string }
const { state, label } = Astro.props;
---
<span class={`status status--${state}`}><span class="dot" aria-hidden="true"></span>{label}</span>
<style>
  .status { display: inline-flex; align-items: center; gap: 0.5em; font: 400 var(--t-label)/1.4 var(--f-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .dot { flex: none; width: 0.55em; height: 0.55em; border-radius: 50%; border: 1.5px solid var(--accent); }
  .status--frozen .dot { background: var(--accent); }
</style>
