---
// The apparatus register. Everything that is evidence about evidence is set here:
// witness attestation, confidence, provenance, counts, caveats. Never the argument.
interface Props { label: string }
const { label } = Astro.props;
---
<aside class="ap"><b>{label}</b><slot /></aside>
<style>
  .ap { font: 400 13px/1.55 var(--f-ui); color: var(--muted); border-top: 1px solid var(--hairline); padding-top: 10px; margin: 0 0 20px; }
  .ap b { display: block; font: 600 11.5px/1.4 var(--f-ui); letter-spacing: 0.06em; text-transform: uppercase; color: var(--heading); margin-bottom: 5px; }
  .ap :global(p) { margin: 0 0 8px; font-size: 13px; line-height: 1.55; }
  .ap :global(p:last-child) { margin-bottom: 0; }
</style>
